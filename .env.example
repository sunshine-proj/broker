# Copy to .env and adjust. Never commit .env.
# The credentials below are development defaults: change them before any deployment.

# --- Host exposure -----------------------------------------------------------
# Address published ports bind to. Keep 127.0.0.1 unless you sit behind a firewall/proxy.
BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
GRAFANA_PORT=3000
POSTGRES_PORT=5432

# --- Backend -----------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO
# json (one object per line) or text
LOG_FORMAT=json
# Key required to trigger a collection job through the API
# (POST /api/v1/collectors/{job}/run, header X-API-Key). Empty disables it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# --- PostgreSQL / TimescaleDB ------------------------------------------------
POSTGRES_DB=marketdata
POSTGRES_USER=marketdata
POSTGRES_PASSWORD=change_me
# Created automatically and used only by integration tests.
POSTGRES_TEST_DB=marketdata_test

# --- Grafana -----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# --- Optional: TwelveData ----------------------------------------------------
TWELVEDATA_API_KEY=change_me

# --- Optional: CoinGecko -----------------------------------------------------
# Free Demo key from https://www.coingecko.com/en/api. Without one, the keyless
# public API is used, at about 5 calls a minute.
COINGECKO_API_KEY=

# --- FRED --------------------------------------------------------------------
# Free key from https://fredaccount.stlouisfed.org/apikeys. Required for FRED
# collection (US Treasury yields, federal funds rate, US indicators).
FRED_API_KEY=
