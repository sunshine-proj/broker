# Environment for Docker Compose. Never commit the real .env; keep it chmod 600.
#
# Create one with random secrets (recommended):
#     python3 scripts/generate_env.py > .env                      # development
#     python3 scripts/generate_env.py --production --domain data.example.com \
#         --email ops@example.com > .env                          # production
# or copy this file and fill in every empty password. Docker Compose refuses
# to start while a required one is empty. Before a production deployment,
# check the file with: python3 scripts/check_env.py .env

# --- Production (docs/deployment.md) ------------------------------------------
# Uncomment for production: the HTTPS reverse proxy instead of published ports.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# Public host name, pointing at this server, and the Let's Encrypt contact.
# DOMAIN=data.example.com
# ACME_EMAIL=ops@example.com
# Basic-auth account for the REST API at https://DOMAIN/api/v1/. The hash comes from
# `docker run --rm -it caddy:2.11.9-alpine caddy hash-password`; keep the quotes.
# API_USERNAME=api
# API_PASSWORD_HASH='$2a$14$...'
# Host ports of the proxy, if 80 and 443 are taken.
# PROXY_HTTP_PORT=80
# PROXY_HTTPS_PORT=443

# --- Host exposure (development) ----------------------------------------------
# docker-compose.override.yml publishes these ports on BIND_ADDRESS. Keep
# 127.0.0.1: the services then answer on this machine only.
BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
GRAFANA_PORT=3000
POSTGRES_PORT=5432
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093

# --- Backend -----------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO
# json (one object per line) or text
LOG_FORMAT=json
# Key required to trigger a collection job through the API
# (POST /api/v1/collectors/{job}/run, header X-API-Key). Empty disables it.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Directory holding the private portfolio file, portfolio.toml (git-ignored;
# copy portfolio/portfolio.example.toml). Loaded at every startup.
PORTFOLIO_DIR=./portfolio

# Time-series storage, applied at every startup. Market observations and
# candles older than COMPRESS_AFTER_DAYS are compressed (empty: never).
# Retention drops older rows for good; empty (the default) keeps everything.
COMPRESS_AFTER_DAYS=30
OBSERVATION_RETENTION_DAYS=
CANDLE_RETENTION_DAYS=

# --- PostgreSQL / TimescaleDB ------------------------------------------------
POSTGRES_DB=marketdata
# The database owner: migrations, the seed file, backups and the command line.
POSTGRES_USER=marketdata
POSTGRES_PASSWORD=
# The backend's own role (read, insert, update), kept up to date by migrate.
BACKEND_DB_USER=marketdata_app
BACKEND_DB_PASSWORD=
# Created automatically and used only by integration tests.
POSTGRES_TEST_DB=marketdata_test

# --- Backups (docs/deployment.md, "Backups") ----------------------------------
# A backup every BACKUP_INTERVAL_HOURS into BACKUP_DIR, keeping the newest
# BACKUP_KEEP. BACKUP_UID and BACKUP_GID must own BACKUP_DIR (see `id`).
# Copy the backups to another machine: a backup on the same disk is no backup.
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
BACKUP_UID=1000
BACKUP_GID=1000

# --- Prometheus and Alertmanager -----------------------------------------------
PROMETHEUS_RETENTION=15d

# --- Grafana -----------------------------------------------------------------
# Choose an administrator name other than "admin" for production.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Read-only database role Grafana connects with. Created and kept up to date
# by the migrate service; changing the password here updates the role.
GRAFANA_DB_USER=grafana_reader
GRAFANA_DB_PASSWORD=

# --- Provider credentials -------------------------------------------------------
# Twelve Data: https://twelvedata.com/pricing (the free Basic plan is enough).
TWELVEDATA_API_KEY=
# CoinGecko: free Demo key from https://www.coingecko.com/en/api. Without one,
# the keyless public API is used, at about 5 calls a minute.
COINGECKO_API_KEY=
# FRED: https://fredaccount.stlouisfed.org/apikeys. Its jobs are disabled by default.
FRED_API_KEY=
