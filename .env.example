# Copy to .env and adjust. Never commit .env.
# The credentials below are development defaults: change them before any deployment.

# --- Host exposure -----------------------------------------------------------
# Address published ports bind to. Keep 127.0.0.1 unless you sit behind a firewall/proxy.
BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
GRAFANA_PORT=3000
POSTGRES_PORT=5432

# --- Backend -----------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO
# json (one object per line) or text
LOG_FORMAT=json

# --- PostgreSQL / TimescaleDB ------------------------------------------------
POSTGRES_DB=marketdata
POSTGRES_USER=marketdata
POSTGRES_PASSWORD=change_me
# Created automatically and used only by integration tests.
POSTGRES_TEST_DB=marketdata_test

# --- Grafana -----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# --- Optional: TwelveData ----------------------------------------------------
TWELVEDATA_API_KEY=change_me
