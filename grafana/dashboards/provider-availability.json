{
  "uid": "provider-availability",
  "title": "Provider Availability",
  "description": "Each provider's health, requests by outcome, latency, retries and rate limiting.",
  "tags": [
    "market-data"
  ],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m",
      "1h",
      "6h",
      "1d"
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "market-data"
      ],
      "asDropdown": true,
      "title": "Market Data dashboards",
      "keepTime": true,
      "includeVars": false
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "provider",
        "label": "Providers",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "marketdata"
        },
        "query": "SELECT name FROM provider WHERE enabled ORDER BY 1",
        "definition": "SELECT name FROM provider WHERE enabled ORDER BY 1",
        "refresh": 1,
        "sort": 0,
        "multi": true,
        "includeAll": true,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "table",
      "title": "Provider health",
      "description": "ProviderDown fires after 5 minutes down, ProviderDegraded after an hour degraded.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "healthy": {
                  "color": "green",
                  "index": 0
                },
                "success": {
                  "color": "green",
                  "index": 1
                },
                "degraded": {
                  "color": "orange",
                  "index": 2
                },
                "running": {
                  "color": "blue",
                  "index": 3
                },
                "down": {
                  "color": "red",
                  "index": 4
                },
                "failed": {
                  "color": "red",
                  "index": 5
                },
                "unknown": {
                  "color": "text",
                  "index": 6
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Health"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "marketdata"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT provider AS \"Provider\", health AS \"Health\",\n       consecutive_failures AS \"Failures in a row\",\n       last_success_at AS \"Last success\", last_error_at AS \"Last error at\",\n       last_error AS \"Last error\"\n  FROM v_provider_status\n WHERE enabled AND provider IN (${provider:sqlstring})\n ORDER BY provider\n"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Health over time",
      "description": "0 healthy, 1 degraded, 2 down.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "lineInterpolation": "stepAfter"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "healthy",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "degraded",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "down",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "marketdata_provider_health_status{provider=~\"${provider:regex}\"}",
          "legendFormat": "{{provider}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Successful requests",
      "description": "Share of requests answered successfully over the last hour.",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (provider) (rate(marketdata_provider_requests_total{provider=~\"${provider:regex}\", outcome=\"success\"}[1h])) / sum by (provider) (rate(marketdata_provider_requests_total{provider=~\"${provider:regex}\"}[1h]))",
          "legendFormat": "{{provider}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Requests by outcome",
      "description": "Requests per hour, one per attempt including retries.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (provider, outcome) (increase(marketdata_provider_requests_total{provider=~\"${provider:regex}\"}[1h]))",
          "legendFormat": "{{provider}} {{outcome}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Request latency, 95th percentile",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(marketdata_provider_request_duration_seconds_bucket{provider=~\"${provider:regex}\"}[30m])))",
          "legendFormat": "{{provider}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Retries and rate limiting",
      "description": "Per hour. A refusal means the provider's quota was used up.",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (provider) (increase(marketdata_provider_retries_total{provider=~\"${provider:regex}\"}[1h]))",
          "legendFormat": "{{provider}} retries",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (provider) (increase(marketdata_provider_budget_refusals_total{provider=~\"${provider:regex}\"}[1h]))",
          "legendFormat": "{{provider}} refused by budget",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Time waiting for the rate limiter",
      "description": "Share of time requests spent waiting for capacity.",
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (provider) (rate(marketdata_provider_rate_limiter_wait_seconds_total{provider=~\"${provider:regex}\"}[30m]))",
          "legendFormat": "{{provider}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "id": 7
    },
    {
      "type": "table",
      "title": "Data freshness",
      "description": "Age of the newest value per provider and kind of data.",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 86400
                    },
                    {
                      "color": "red",
                      "value": 345600
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "marketdata"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT provider AS \"Provider\",\n       asset_type || ' ' || observation_type AS \"Data\",\n       series AS \"Series\",\n       last_observed_at AS \"Latest value at\",\n       last_ingested_at AS \"Collected at\",\n       age_seconds AS \"Age\"\n  FROM v_data_freshness\n WHERE provider IN (${provider:sqlstring})\n ORDER BY provider, asset_type, observation_type\n"
        }
      ],
      "id": 8
    }
  ]
}
