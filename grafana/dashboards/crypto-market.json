      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT symbol AS \"Coin\",\n       instrument_name AS \"Name\",\n       provider AS \"Provider\",\n       max(value) FILTER (WHERE observation_type = 'price') AS \"Price\",\n       max(currency) FILTER (WHERE observation_type = 'price') AS \"Currency\",\n       max(value) FILTER (WHERE observation_type = 'market_cap') AS \"Market cap\",\n       max(value) FILTER (WHERE observation_type = 'volume') AS \"Volume\",\n       max(value) FILTER (WHERE observation_type = 'circulating_supply')\n           AS \"Circulating supply\",\n       max(value) FILTER (WHERE observation_type = 'dominance') AS \"Dominance\",\n       max(observed_at) FILTER (WHERE observation_type = 'price') AS \"Price at\"\n  FROM v_latest_observation\n WHERE asset_type = 'crypto' AND symbol IN (${coin:sqlstring})\n GROUP BY symbol, instrument_name, provider\n ORDER BY \"Market cap\" DESC NULLS LAST\n"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Price",
      "description": "Logarithmic scale, so coins of very different prices fit one chart.",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "showPoints": "never",
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
