      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT observed_at AS \"time\",\n       symbol || ' · ' || provider AS metric,\n       (value / first_value(value) OVER (\n            PARTITION BY symbol, provider ORDER BY observed_at) - 1) * 100 AS value\n  FROM v_observation\n WHERE $__timeFilter(observed_at)\n   AND asset_type = 'crypto' AND symbol IN (${coin:sqlstring}) AND observation_type = 'price'\n ORDER BY 1\n"
        }
      ],
      "id": 4
    },
