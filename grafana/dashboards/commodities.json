        },
        "query": "SELECT DISTINCT symbol FROM v_latest_observation WHERE asset_type = 'commodity' ORDER BY 1",
        "definition": "SELECT DISTINCT symbol FROM v_latest_observation WHERE asset_type = 'commodity' ORDER BY 1",
