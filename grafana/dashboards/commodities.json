      {
        "name": "candle_commodity",
        "label": "Candles for",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "marketdata"
        },
        "query": "SELECT DISTINCT symbol FROM v_latest_observation WHERE asset_type = 'commodity' ORDER BY 1",
        "definition": "SELECT DISTINCT symbol FROM v_latest_observation WHERE asset_type = 'commodity' ORDER BY 1",
        "refresh": 1,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "Data sources",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Stock, ETF, intraday currency and gold data: [Twelve Data](https://twelvedata.com)."
      },
      "id": 1
    },
    {
      "type": "text",
      "title": "Coverage",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Spot gold (XAU/USD) is the only commodity on Twelve Data's free plan. Silver, crude oil and natural gas need a paid plan; free government sources republish oil and gas prices under third-party licences, so they are not collected."
      },
      "id": 2
    },
    {
      "type": "table",
      "title": "Latest prices",
      "description": "Spot prices are indicative over-the-counter quotes, per troy ounce for metals.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "marketdata"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT symbol AS \"Symbol\",\n       instrument_name AS \"Name\",\n       provider AS \"Provider\",\n       value AS \"Price\",\n       coalesce(currency, unit) AS \"Unit\",\n       quote_kind AS \"Kind\",\n       freshness AS \"Freshness\",\n       observed_at AS \"Observed\",\n       age_seconds AS \"Age\"\n  FROM v_latest_observation\n WHERE asset_type = 'commodity' AND symbol IN (${commodity:sqlstring}) AND observation_type = 'price'\n ORDER BY symbol, provider\n"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Price",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "marketdata"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT observed_at AS \"time\",\n       symbol || ' · ' || provider AS metric,\n       value\n  FROM v_observation\n WHERE $__timeFilter(observed_at)\n   AND asset_type = 'commodity' AND symbol IN (${commodity:sqlstring}) AND observation_type = 'price'\n ORDER BY 1\n"
        }
      ],
      "id": 4
    },
    {
      "type": "candlestick",
      "title": "Daily candles: $candle_commodity",
      "description": "Closed daily candles, dated by the day they open (UTC).",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "candles",
        "candleStyle": "candles",
        "colorStrategy": "open-close"
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "marketdata"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT timestamp AS \"time\", open, high, low, close\n  FROM v_candle\n WHERE asset_type = 'commodity' AND interval = '1day'\n   AND symbol = ${candle_commodity:sqlstring}\n   AND $__timeFilter(timestamp)\n ORDER BY 1\n"
        }
      ],
      "id": 5
    },
    {
      "type": "table",
      "title": "Data freshness",
      "description": "Prices are collected every 30 minutes; spot markets close at weekends.",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 10800
                    },
                    {
                      "color": "red",
                      "value": 259200
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "marketdata"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT provider AS \"Provider\",\n       asset_type || ' ' || observation_type AS \"Data\",\n       series AS \"Series\",\n       last_observed_at AS \"Latest value at\",\n       last_ingested_at AS \"Collected at\",\n       age_seconds AS \"Age\"\n  FROM v_data_freshness\n WHERE asset_type = 'commodity'\n ORDER BY provider, asset_type, observation_type\n"
        }
      ],
      "id": 6
    }
  ]
}
