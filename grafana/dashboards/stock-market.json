        },
        "query": "SELECT DISTINCT symbol FROM v_latest_observation WHERE asset_type = 'stock' ORDER BY 1",
        "definition": "SELECT DISTINCT symbol FROM v_latest_observation WHERE asset_type = 'stock' ORDER BY 1",
        "refresh": 1,
        "sort": 0,
        "multi": true,
        "includeAll": true,
        "current": {},
        "options": []
      },
      {
        "name": "candle_symbol",
        "label": "Candles for",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "marketdata"
        },
        "query": "SELECT DISTINCT symbol FROM v_latest_observation WHERE asset_type = 'stock' ORDER BY 1",
        "definition": "SELECT DISTINCT symbol FROM v_latest_observation WHERE asset_type = 'stock' ORDER BY 1",
        "refresh": 1,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "Data sources",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Stock, ETF, intraday currency and gold data: [Twelve Data](https://twelvedata.com)."
      },
      "id": 1
    },
    {
      "type": "table",
      "title": "Latest prices",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 14,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "marketdata"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT symbol AS \"Symbol\",\n       instrument_name AS \"Name\",\n       provider AS \"Provider\",\n       value AS \"Price\",\n       coalesce(currency, unit) AS \"Unit\",\n       quote_kind AS \"Kind\",\n       freshness AS \"Freshness\",\n       observed_at AS \"Observed\",\n       age_seconds AS \"Age\"\n  FROM v_latest_observation\n WHERE asset_type = 'stock' AND observation_type = 'price' AND symbol IN (${symbol:sqlstring})\n ORDER BY symbol, provider\n"
        }
      ],
      "id": 2
    },
    {
      "type": "table",
      "title": "Daily change",
      "description": "Last daily close against the one before.",
      "gridPos": {
        "x": 14,
        "y": 3,
        "w": 10,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Change"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 0
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "marketdata"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT symbol AS \"Symbol\",\n       timestamp AS \"Day\",\n       close AS \"Close\",\n       (close / previous_close - 1) * 100 AS \"Change\"\n  FROM (\n        SELECT symbol, provider, timestamp, close,\n               lag(close) OVER w AS previous_close,\n               row_number() OVER (PARTITION BY symbol, provider\n                                  ORDER BY timestamp DESC) AS newest\n          FROM v_candle\n         WHERE asset_type = 'stock' AND interval = '1day'\n           AND timestamp > now() - interval '15 days'\n        WINDOW w AS (PARTITION BY symbol, provider ORDER BY timestamp)\n       ) c\n WHERE newest = 1 AND symbol IN (${symbol:sqlstring})\n ORDER BY \"Change\" DESC NULLS LAST\n"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Price",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "marketdata"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT observed_at AS \"time\",\n       symbol || ' · ' || provider AS metric,\n       value\n  FROM v_observation\n WHERE $__timeFilter(observed_at)\n   AND asset_type = 'stock' AND observation_type = 'price' AND symbol IN (${symbol:sqlstring})\n ORDER BY 1\n"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Relative performance",
      "description": "Change since the first value in the selected time range.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "marketdata"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT observed_at AS \"time\",\n       symbol || ' · ' || provider AS metric,\n       (value / first_value(value) OVER (\n            PARTITION BY symbol, provider ORDER BY observed_at) - 1) * 100 AS value\n  FROM v_observation\n WHERE $__timeFilter(observed_at)\n   AND asset_type = 'stock' AND observation_type = 'price' AND symbol IN (${symbol:sqlstring})\n ORDER BY 1\n"
        }
      ],
      "id": 5
    },
    {
      "type": "candlestick",
      "title": "Daily candles: $candle_symbol",
      "description": "Closed daily candles, unadjusted, dated by the trading day.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "candles+volume",
        "candleStyle": "candles",
        "colorStrategy": "open-close"
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "marketdata"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT timestamp AS \"time\", open, high, low, close, volume\n  FROM v_candle\n WHERE asset_type = 'stock' AND interval = '1day'\n   AND symbol = ${candle_symbol:sqlstring}\n   AND $__timeFilter(timestamp)\n ORDER BY 1\n"
        }
      ],
      "id": 6
    },
    {
      "type": "table",
      "title": "Data freshness",
      "description": "Prices only change while the market is open, so weekends age the data.",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 172800
                    },
                    {
                      "color": "red",
                      "value": 345600
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "marketdata"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT provider AS \"Provider\",\n       asset_type || ' ' || observation_type AS \"Data\",\n       series AS \"Series\",\n       last_observed_at AS \"Latest value at\",\n       last_ingested_at AS \"Collected at\",\n       age_seconds AS \"Age\"\n  FROM v_data_freshness\n WHERE asset_type = 'stock'\n ORDER BY provider, asset_type, observation_type\n"
        }
      ],
      "id": 7
    }
  ]
}
