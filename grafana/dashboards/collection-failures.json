{
  "uid": "collection-failures",
  "title": "Collection Failures",
  "description": "Failing jobs, their errors, and how long since each last succeeded.",
  "tags": [
    "market-data"
  ],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m",
      "1h",
      "6h",
      "1d"
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "market-data"
      ],
      "asDropdown": true,
      "title": "Market Data dashboards",
      "keepTime": true,
      "includeVars": false
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Jobs",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "marketdata"
        },
        "query": "SELECT name FROM collection_job WHERE enabled ORDER BY 1",
        "definition": "SELECT name FROM collection_job WHERE enabled ORDER BY 1",
        "refresh": 1,
        "sort": 0,
        "multi": true,
        "includeAll": true,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "table",
      "title": "Firing alerts",
      "description": "Alerts firing now. docs/monitoring.md explains each one.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "ALERTS{alertstate=\"firing\", alertname=~\"Collector.*|Provider.*|DataStale|DatabaseDown\"}",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "alertstate": true
            }
          }
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Failed runs per hour",
      "description": "Runs of the backend's scheduler and API triggers; command-line runs are in the tables below.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (job_name) (increase(marketdata_collector_runs_total{job_name=~\"${job:regex}\", status=\"failed\"}[1h]))",
          "legendFormat": "{{job_name}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Time since last success, in intervals",
      "description": "1 means one schedule interval. CollectorJobNotSucceeding fires beyond twice the interval plus an hour (jobs outside market hours).",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(time() - marketdata_job_last_success_timestamp_seconds{job_name=~\"${job:regex}\"}) / marketdata_job_expected_interval_seconds{job_name=~\"${job:regex}\"}",
          "legendFormat": "{{job_name}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "id": 3
    },
    {
      "type": "table",
      "title": "Job status",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "healthy": {
                  "color": "green",
                  "index": 0
                },
                "success": {
                  "color": "green",
                  "index": 1
                },
                "degraded": {
                  "color": "orange",
                  "index": 2
                },
                "running": {
                  "color": "blue",
                  "index": 3
                },
                "down": {
                  "color": "red",
                  "index": 4
                },
                "failed": {
                  "color": "red",
                  "index": 5
                },
                "unknown": {
                  "color": "text",
                  "index": 6
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "marketdata"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT job AS \"Job\", provider AS \"Provider\", kind AS \"Kind\",\n       schedule AS \"Schedule\", last_status AS \"Last status\",\n       last_finished_at AS \"Last finished\", last_error AS \"Last error\"\n  FROM v_job_status\n WHERE enabled AND job IN (${job:sqlstring})\n ORDER BY (last_status = 'failed') DESC, job\n"
        }
      ],
      "id": 4
    },
    {
      "type": "table",
      "title": "Failures by job",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "marketdata"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT job AS \"Job\", count(*) AS \"Failed runs\",\n       max(started_at) AS \"Latest failure\"\n  FROM v_execution\n WHERE status = 'failed' AND $__timeFilter(started_at)\n   AND job IN (${job:sqlstring})\n GROUP BY job\n ORDER BY 2 DESC\n"
        }
      ],
      "id": 5
    },
    {
      "type": "table",
      "title": "Failed runs",
      "description": "",
      "gridPos": {
        "x": 8,
        "y": 23,
        "w": 16,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "marketdata"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT started_at AS \"Started\", job AS \"Job\", provider AS \"Provider\",\n       trigger AS \"Trigger\", duration_seconds AS \"Duration\", error AS \"Error\"\n  FROM v_execution\n WHERE status = 'failed' AND $__timeFilter(started_at)\n   AND job IN (${job:sqlstring})\n ORDER BY started_at DESC\n LIMIT 200\n"
        }
      ],
      "id": 6
    },
    {
      "type": "table",
      "title": "Data freshness",
      "description": "Age of the newest value per provider and kind of data.",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 86400
                    },
                    {
                      "color": "red",
                      "value": 345600
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "marketdata"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT provider AS \"Provider\",\n       asset_type || ' ' || observation_type AS \"Data\",\n       series AS \"Series\",\n       last_observed_at AS \"Latest value at\",\n       last_ingested_at AS \"Collected at\",\n       age_seconds AS \"Age\"\n  FROM v_data_freshness\n WHERE true\n ORDER BY provider, asset_type, observation_type\n"
        }
      ],
      "id": 7
    }
  ]
}
