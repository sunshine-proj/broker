              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "marketdata"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT provider AS \"Provider\",\n       asset_type || ' ' || observation_type AS \"Data\",\n       freshness AS \"Freshness\",\n       observations AS \"Values\",\n       median_seconds AS \"Median\",\n       p95_seconds AS \"95th percentile\",\n       max_seconds AS \"Longest\"\n  FROM v_collection_latency\n ORDER BY provider, asset_type, observation_type\n"
        }
      ],
      "id": 9
    },
    {
