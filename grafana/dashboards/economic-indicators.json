                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 172800
                    },
                    {
                      "color": "red",
                      "value": 345600
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "marketdata"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT code AS \"Indicator\",\n       provider AS \"Provider\",\n       max(observed_at) AS \"Latest period\",\n       max(ingested_at) AS \"Last stored\",\n       EXTRACT(EPOCH FROM now() - max(ingested_at)) AS \"Since stored\"\n  FROM v_indicator_value\n GROUP BY code, provider\n ORDER BY code\n"
        }
      ],
      "id": 5
    }
  ]
