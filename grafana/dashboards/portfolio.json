      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "marketdata"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT symbol AS metric, value\n  FROM v_portfolio_holding\n WHERE portfolio = ${portfolio:sqlstring} AND value IS NOT NULL\n ORDER BY value DESC\n"
        }
      ],
      "id": 7
    },
    {
      "type": "table",
      "title": "Price freshness",
      "description": "The day of each holding's price. Without a close in the last 7 days a holding has no value.",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 259200
                    },
                    {
                      "color": "red",
                      "value": 604800
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "marketdata"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT symbol AS \"Symbol\",\n       provider AS \"Priced by\",\n       price_day AS \"Close of\",\n       extract(epoch FROM now() - price_day) AS \"Age\"\n  FROM v_portfolio_holding\n WHERE portfolio = ${portfolio:sqlstring}\n ORDER BY price_day NULLS FIRST, symbol\n"
        }
      ],
      "id": 8
    }
  ]
