  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "portfolio",
        "label": "Portfolio",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "marketdata"
        },
        "query": "SELECT name FROM portfolio ORDER BY name",
        "definition": "SELECT name FROM portfolio ORDER BY name",
