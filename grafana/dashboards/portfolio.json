        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "marketdata"
        },
        "query": "SELECT base_currency FROM portfolio WHERE name = ${portfolio:sqlstring}",
        "definition": "SELECT base_currency FROM portfolio WHERE name = ${portfolio:sqlstring}",
        "refresh": 1,
