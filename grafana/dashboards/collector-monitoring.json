{
  "uid": "collector-monitoring",
  "title": "Collector Monitoring",
  "description": "Provider health, collection jobs, their runs and failures, and data freshness.",
  "tags": [
    "market-data"
  ],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m",
      "1h",
      "6h",
      "1d"
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "market-data"
      ],
      "asDropdown": true,
      "title": "Market Data dashboards",
      "keepTime": true,
      "includeVars": false
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "table",
      "title": "Provider health",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "healthy": {
                  "color": "green",
                  "index": 0
                },
                "success": {
                  "color": "green",
                  "index": 1
                },
                "degraded": {
                  "color": "orange",
                  "index": 2
                },
                "running": {
                  "color": "blue",
                  "index": 3
                },
                "down": {
                  "color": "red",
                  "index": 4
                },
                "failed": {
                  "color": "red",
                  "index": 5
                },
                "unknown": {
                  "color": "text",
                  "index": 6
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Health"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "marketdata"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT provider AS \"Provider\", enabled AS \"Enabled\", health AS \"Health\",\n       consecutive_failures AS \"Failures in a row\",\n       last_success_at AS \"Last success\", last_error_at AS \"Last error at\",\n       last_error AS \"Last error\"\n  FROM v_provider_status\n ORDER BY provider\n"
        }
      ],
      "id": 1
    },
    {
      "type": "table",
      "title": "Collection jobs",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "healthy": {
                  "color": "green",
                  "index": 0
                },
                "success": {
                  "color": "green",
                  "index": 1
                },
                "degraded": {
                  "color": "orange",
                  "index": 2
                },
                "running": {
                  "color": "blue",
                  "index": 3
                },
                "down": {
                  "color": "red",
                  "index": 4
                },
                "failed": {
                  "color": "red",
                  "index": 5
                },
                "unknown": {
                  "color": "text",
                  "index": 6
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "marketdata"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT job AS \"Job\", provider AS \"Provider\", kind AS \"Kind\",\n       enabled AS \"Enabled\", schedule AS \"Schedule\",\n       last_status AS \"Last status\", last_started_at AS \"Last run\",\n       next_run_at AS \"Next run\", last_error AS \"Last error\"\n  FROM v_job_status\n ORDER BY job\n"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Runs per hour",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "marketdata"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket('1 hour', started_at) AS \"time\", status AS metric,\n       count(*) AS value\n  FROM v_execution\n WHERE $__timeFilter(started_at)\n GROUP BY 1, 2\n ORDER BY 1\n"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Records written per hour",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "marketdata"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket('1 hour', started_at) AS \"time\", job AS metric,\n       sum(records_written) AS value\n  FROM v_execution\n WHERE $__timeFilter(started_at)\n GROUP BY 1, 2\n ORDER BY 1\n"
        }
      ],
      "id": 4
    },
    {
      "type": "table",
      "title": "Failed runs",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "marketdata"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT started_at AS \"Started\", job AS \"Job\", trigger AS \"Trigger\",\n       duration_seconds AS \"Duration\", error AS \"Error\"\n  FROM v_execution\n WHERE status = 'failed' AND $__timeFilter(started_at)\n ORDER BY started_at DESC\n LIMIT 100\n"
        }
      ],
      "id": 5
    },
    {
      "type": "table",
      "title": "Data freshness",
      "description": "Age of the newest value per provider and kind of data.",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 86400
                    },
                    {
                      "color": "red",
                      "value": 345600
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "marketdata"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketdata"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT provider AS \"Provider\",\n       asset_type || ' ' || observation_type AS \"Data\",\n       series AS \"Series\",\n       last_observed_at AS \"Latest value at\",\n       last_ingested_at AS \"Collected at\",\n       age_seconds AS \"Age\"\n  FROM v_data_freshness\n WHERE true\n ORDER BY provider, asset_type, observation_type\n"
        }
      ],
      "id": 6
    }
  ]
}
